{
  "[dart]": {
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [80],
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    }
  },
  "dart.lineLength": 80,
  "dart.previewFlutterUiGuides": true,
  "dart.showTodos": true,
  "files.exclude": {
    "**/*.freezed.dart": true,
    "**/*.g.dart": true
  },
  "search.exclude": {
    "**/*.freezed.dart": true,
    "**/*.g.dart": true,
    "lib/l10n/generated": true
  }
}
